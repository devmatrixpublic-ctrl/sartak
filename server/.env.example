# Copy to .env for local development: cp .env.example .env
# Every setting has a safe local default, so an empty .env also works.
# Never commit a real .env. In production, set these in the host's environment, not in a file.

# dev | production. Production refuses to boot without the secrets and roots below.
SATARK_ENV=dev

# Local SQLite by default. In production use Postgres, for example:
# SATARK_DATABASE_URL=postgresql+psycopg://satark_app:CHANGE_ME@host:5432/satark
SATARK_DATABASE_URL=sqlite:///./satark_dev.db
# Owner connection used only by `alembic upgrade head`, so SATARK_DATABASE_URL can be the limited role in ops/security/db_roles.sql.
# SATARK_MIGRATION_DATABASE_URL=

# Rate-limit counters only. In dev the limiter is in memory and this is not used.
# SATARK_REDIS_URL=redis://localhost:6379/0

# Signs device tokens. At least 32 bytes and not the dev default in production.
# SATARK_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Keys the hash of phone numbers and invite codes. Falls back to the JWT secret when empty.
# SATARK_PHONE_PEPPER=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_VALUE

# Device identity (Android Key Attestation). Required in production.
# SATARK_AUTH_ATTESTATION_ROOTS=/srv/certs/google_attestation_roots.pem
# SATARK_AUTH_EXPECTED_PACKAGE=com.satark.app
# Comma-separated SHA-256 of the signing certificate. List a debug digest only while testing, and remove it before real use.
# SATARK_AUTH_EXPECTED_SIGNING_SHA256=
# Dev only: lets a debug build register without attestation. Refused outside SATARK_ENV=dev.
# SATARK_AUTH_ENABLE_DEV_TOKEN=true

# Proxies in front of the app that append to X-Forwarded-For. 0 = ignore the header.
# SATARK_TRUSTED_PROXY_HOPS=0

# Razorpay (test mode). Without these a local stub order id is used. Never real-looking in git.
# SATARK_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
# SATARK_RAZORPAY_KEY_SECRET=
# SATARK_RAZORPAY_WEBHOOK_SECRET=

# Firebase service account: the JSON text itself (as pasted into a host's dashboard), or a path to the file for local use.
# Without it, alerts use a local stub and phone sign-in answers "not set up".
# SATARK_FIREBASE_CREDENTIALS_JSON=/path/to/firebase-adminsdk.json

# Optional limits and the payee fan-in check.
# SATARK_MAX_BODY_BYTES=65536
# SATARK_MULE_FANIN_THRESHOLD=3
# SATARK_MULE_FANIN_WINDOW_MINUTES=60
